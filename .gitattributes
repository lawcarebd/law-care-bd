# Normalise line endings to LF in the repo; Git handles CRLF checkout on Windows
* text=auto eol=lf

# Explicitly text files
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.xml     text eol=lf
*.json    text eol=lf
*.svg     text eol=lf

# Binary assets — never touch line endings
*.ico     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary
